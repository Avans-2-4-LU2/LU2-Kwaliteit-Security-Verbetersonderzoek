            "data": {
              "type": "tm.Process",
              "name": "Appointment Service Layer",
              "description": "Business logic and authorization enforcement for appointment operations.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "Application",
              "threats": [
                {
                  "id": "86f14af0-432f-4271-964c-a03e7b163709",
                  "title": "Missing function-level authorization",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "AppointmentService methods using empty @Authorized() only verify login state and do not enforce required privileges.",
                  "mitigation": "Use explicit privilege strings for each annotated method and verify the user is authorized for the requested appointment data.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "8,1"
                },
                {
                  "id": "2d5b1a7f-403f-4d29-8d8c-03e0f8e2b4b6",
                  "title": "Insecure direct object reference",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Appointment and patient identifiers are accepted without verifying ownership or authorization.",
                  "mitigation": "Validate object ownership and enforce authorization for all appointment and patient record access.",
                  "modelType": "STRIDE",
                  "new": true,
                  "number": 5,
                  "score": "8,2"
                }
              ],
              "threatFrequency": {
