            "data": {
              "type": "tm.Process",
              "name": "Appointment Web Interface",
              "description": "Browser-facing JSP frontend for appointment scheduling and searches.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "User",
              "threats": [
                {
                  "id": "05a7e922-93cb-4490-a5c0-53641512bfc1",
                  "title": "Stored/Reflected XSS",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Input fields such as chosenLocation or fromDate are rendered into JSP without HTML entity encoding, allowing malicious script execution in victims' browsers.",
                  "mitigation": "Wrap all EL expressions in JSPs with <c:out value=\"${...}\" /> and validate input before rendering.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "8,1"
                },
                {
                  "id": "e648e2e2-8fa5-428a-9106-2bd34d405eae",
                  "title": "Remote code execution via outdated dependencies",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Elevation of privilege",
                  "description": "The core module relies on vulnerable libraries that can be exploited for remote code execution.",
                  "mitigation": "Upgrade vulnerable dependencies in pom.xml or apply vendor mitigations.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "9,8"
                },
                {
                  "id": "bb6a0c8d-b7c1-4d4b-8a8f-1a4e1f5fbc20",
                  "title": "Cross-Site Request Forgery",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "State-changing appointment actions are exposed through the web interface without CSRF tokens or strict cookie controls.",
                  "mitigation": "Implement anti-CSRF tokens and set session cookies with SameSite attributes.",
                  "modelType": "STRIDE",
                  "new": true,
                  "number": 4,
                  "score": "8,3"
                }
              ],
              "threatFrequency": {
                "spoofing": 0,
                "tampering": 2,
                "repudiation": 0,
                "informationDisclosure": 0,
                "denialOfService": 0,
                "elevationOfPrivilege": 0
              }
            }
