            "id": "f5daca9d-d1e9-4e00-8ce8-30cf87caec23",
            "data": {
              "type": "tm.Process",
              "name": "Appointment Service Layer",
              "description": "The internal business logic layer, responsible for enforcing security rules and interacting with the database. It exposes several services to the rest of the application, including AppointmentService, AppointmentQueryService, and AppointmentDataService. This layer is an internal entry point that can be called from web controllers, other modules, or scripts. It implicitly trusts that the calling code has performed initial validation but is ultimately responsible for all authorization decisions.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "Application",
              "threats": [
                {
                  "id": "86f14af0-432f-4271-964c-a03e7b163709",
                  "title": "Missing Function-Level Access Control",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of Privilege",
                  "description": "Several methods in the AppointmentService use an empty @Authorized() annotation, which only checks if a user is authenticated, not if they have the specific privileges required for the action. This allows any logged-in user to perform sensitive operations.",
                  "mitigation": "Replace all empty @Authorized() annotations with annotations that specify the required privilege (e.g., @Authorized(PrivilegeConstants.EDIT_APPOINTMENTS)). Ensure that all service methods have appropriate privilege checks.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "8,1"
                },
                {
                  "id": "2d5b1a7f-403f-4d29-8d8c-03e0f8e2b4b6",
                  "title": "Insecure Direct Object Reference (IDOR)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information Disclosure",
                  "description": "When fetching or modifying appointment-related data, the service layer accepts identifiers (e.g., appointmentId, patientId) without verifying that the currently authenticated user has the right to access or modify the requested object. An attacker could iterate through IDs to access or modify data belonging to other users.",
                  "mitigation": "Before performing any action on an object, verify that the current user has ownership or the necessary permissions. For example, before showing appointment details, check if the appointment belongs to the logged-in patient or if the user is a clinician with the appropriate rights.",
                  "modelType": "STRIDE",
                  "new": true,
                  "number": 5,
                  "score": "8,2"
                }
              ],
              "threatFrequency": {
                "spoofing": 1,
                "tampering": 2,
                "repudiation": 0,
                "informationDisclosure": 0,
                "denialOfService": 0,
                "elevationOfPrivilege": 0
              }
            }
