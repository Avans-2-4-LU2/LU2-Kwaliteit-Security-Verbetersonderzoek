            "id": "f3a62c6c-f82a-44c4-8f4c-9ccbdea42c59",
            "data": {
              "type": "tm.Process",
              "name": "Appointment Web Interface",
              "description": "The web-facing component of the module, comprising JSP files and Spring Controllers. It handles all HTTP requests, renders the UI, and serves REST API endpoints. This layer is the primary attack surface, exposed to both authenticated and unauthenticated users. High-risk entry points include the AppointmentRestController and form-handling controllers like AppointmentFormController, which process user input and initiate state changes. This layer implicitly trusts the Service Layer to perform authorization checks.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "User",
              "threats": [
                {
                  "id": "05a7e922-93cb-4490-a5c0-53641512bfc1",
                  "title": "Stored/Reflected XSS",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "User-controllable input, such as appointment details or search parameters, is rendered into JSP pages without sufficient output encoding. This allows an attacker to inject malicious scripts that execute in the context of a victim's browser, leading to session hijacking or data theft.",
                  "mitigation": "Ensure all user-supplied data is properly encoded before being rendered in the UI. Use JSTL's <c:out> tag for all data displayed in JSPs. Implement a Content Security Policy (CSP) to restrict the sources of executable scripts.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "8,1"
                },
                {
                  "id": "e648e2e2-8fa5-428a-9106-2bd34d405eae",
                  "title": "Remote code execution via outdated dependencies",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Elevation of privilege",
                  "description": "The module depends on OpenMRS core and other libraries with known vulnerabilities (e.g., commons-collections). An attacker could exploit these vulnerabilities to achieve remote code execution on the server.",
                  "mitigation": "Regularly scan dependencies for known vulnerabilities using tools like OWASP Dependency-Check. Update the pom.xml to use the latest, secure versions of libraries. Follow OpenMRS guidelines for managing dependencies.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "9,8"
                },
                {
                  "id": "bb6a0c8d-b7c1-4d4b-8a8f-1a4e1f5fbc20",
                  "title": "Cross-Site Request Forgery (CSRF)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "State-changing actions, such as booking or cancelling an appointment, are processed without verifying a unique, per-request token. An attacker can craft a malicious link or form that, when visited by an authenticated user, will execute an action on their behalf.",
                  "mitigation": "Implement anti-CSRF tokens (e.g., using Spring Security's CSRF protection) for all state-changing requests. All POST requests should be protected. Set the SameSite attribute on session cookies to 'Strict' or 'Lax'.",
                  "modelType": "STRIDE",
                  "new": true,
                  "number": 4,
                  "score": "8,3"
                }
              ],
              "threatFrequency": {
                "spoofing": 0,
                "tampering": 2,
                "repudiation": 0,
                "informationDisclosure": 0,
                "denialOfService": 0,
                "elevationOfPrivilege": 0
              }
            }
